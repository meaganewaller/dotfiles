#!/usr/bin/env bash
set -eo pipefail
{{ template "functions.sh" . }}

{{ if .isCodespace -}}
exit 0
{{ end -}}

if ! command_available fish; then
  echo "🐟 fish not installed, skipping"
  exit 0
fi

fish_path=$(command -v fish)

if [ -f /etc/shells ] && ! grep -qF "$fish_path" /etc/shells; then
  echo "🐟 adding $fish_path to /etc/shells"
  echo "$fish_path" | sudo tee -a /etc/shells > /dev/null
fi

{{ if eq .chezmoi.os "darwin" -}}
current_shell=$(dscl . -read "$HOME" UserShell | awk '{print $2}')
if [[ "$current_shell" != "$fish_path" ]]; then
  echo "🐟 changing login shell to $fish_path"
  chsh -s "$fish_path"
fi
{{ end -}}
