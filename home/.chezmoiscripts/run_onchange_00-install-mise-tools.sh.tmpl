#!/bin/bash

# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# mise lock hash: {{ include "dot_config/mise/mise.lock" | sha256sum }}

[ -n "${DEBUG:-}" ] && set -o xtrace
set -o errexit
set -o nounset

# Only run mise if available. Exit 1 (not 0) when missing: this script is
# run_onchange_ (content-hash gated), and chezmoi only records a script's
# hash as "successfully applied" on exit 0. On a fresh machine this script
# can run before mise itself is installed (e.g. by
# run_onchange_install-packages-darwin.sh.tmpl, which sorts after this one
# alphabetically) -- failing loudly here makes chezmoi retry this script on
# every subsequent `chezmoi apply` until mise is actually available, instead
# of silently skipping forever until the tracked config/lockfile hash changes
# again.
if ! command -v mise >/dev/null 2>&1; then
    echo "mise not found -- install it first, then re-run chezmoi apply" >&2
    exit 1
fi

echo "Installing global mise tools..."

# Authenticate to GitHub so mise (and the aqua backend it delegates to) get
# the 5000/hr authenticated rate limit instead of the 60/hr anonymous cap.
# CI sets GITHUB_TOKEN via the step env; on a developer machine, fall back
# to gh's stored auth token.
{{- if lookPath "gh" }}
if [ -z "${GITHUB_TOKEN:-}" ]; then
    GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
    export GITHUB_TOKEN
fi
{{- end }}

mise install --yes

echo "Pruning unused mise tool versions and stale caches..."
mise prune --yes
mise cache prune

echo "Global mise tools installation complete"
