#!/usr/bin/env bash
# check-secrets-before-write -- Claude Code PreToolUse content scanner.
#
# Scans Write/Edit/MultiEdit payload content for likely hardcoded secrets and
# denies the tool call when a high-signal pattern is detected.

set -o nounset
set -o pipefail

INPUT="$(cat)"

tool_name="$(printf '%s' "${INPUT}" | jq -r '.tool_name // empty' 2>/dev/null || true)"
case "${tool_name}" in
Write|Edit|MultiEdit) ;;
*) exit 0 ;;
esac

file_path="$(printf '%s' "${INPUT}" | jq -r '.tool_input.file_path // "(unknown)"' 2>/dev/null || true)"

content_to_scan="$({
	printf '%s' "${INPUT}" | jq -r '.tool_input.content // empty' 2>/dev/null || true
	printf '%s' "${INPUT}" | jq -r '.tool_input.new_string // empty' 2>/dev/null || true
	printf '%s' "${INPUT}" | jq -r '.tool_input.edits[]?.new_string // empty' 2>/dev/null || true
} | sed '/^$/d')"

[[ -z "${content_to_scan}" ]] && exit 0

patterns=(
	'AKIA[0-9A-Z]{16}'
	'ASIA[0-9A-Z]{16}'
	'ghp_[A-Za-z0-9]{36}'
	'github_pat_[A-Za-z0-9_]{80,}'
	'sk-[A-Za-z0-9]{20,}'
	'xox[baprs]-[A-Za-z0-9-]{20,}'
	'api[_-]?key[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{12,}["'"'"']'
	'(password|passwd|secret|token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,}["'"'"']'
	'-----BEGIN (RSA|EC|OPENSSH|PRIVATE) KEY-----'
	'DATABASE_URL[[:space:]]*=[[:space:]]*postgres://[^$[:space:]]+'
)

found=()
for pattern in "${patterns[@]}"; do
	if printf '%s\n' "${content_to_scan}" | grep -Eiq -- "${pattern}"; then
		found+=("${pattern}")
	fi
done

if ((${#found[@]} > 0)); then
	joined_patterns="$(printf '%s; ' "${found[@]}")"
	joined_patterns="${joined_patterns%; }"
	reason="Blocked write to ${file_path}: detected potential secret material. Matched patterns: ${joined_patterns}. Move secrets to env vars or secret storage before writing."
	jq -cn --arg r "${reason}" \
		'{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
	fi

exit 0
