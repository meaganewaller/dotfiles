# Chezmoi Configuration File Template
# Processed during `chezmoi init` to create the actual config file.
# Prompted values are stored in [data] and available to all templates via `.`.


{{ $gitName := "" -}}
{{ $gitUsername := "" -}}
{{- $gitEmail := "" -}}
{{- $credClaudeApi := "" -}}
{{- $credBuildkite := "" -}}
{{- $workProfile := false -}}
{{- $useBedrock := false -}}
{{- /* Machine-local half of each identity under `git.identities` in
       .chezmoidata/git.yaml. A blank email means "this identity is not used on
       this machine": its includeIf, its overlay file, and its trust-map line
       all disappear together, which is what lets one source tree serve a
       personal laptop and a client machine with no per-machine branching.

       These keys are spelled out literally instead of looped over the data
       file because .chezmoidata is NOT in scope while this template renders --
       chezmoi executes .chezmoi.toml.tmpl to *produce* the config that
       determines sourceDir, before any source state is read. (Verified: a
       `hasKey . "<datakey>"` probe is false here.) So adding a client means
       adding its prompts below as well as its entry in git.yaml, and
       test/git-identity.bats asserts the two never drift apart. */ -}}
{{- $tdEmail := "" -}}
{{- $tdKey := "" -}}
{{- $ghEmail := "" -}}
{{- $ghKey := "" -}}
{{- if stdinIsATTY -}}
{{- $gitName = promptStringOnce . "git.name" "Git user.name" -}}
{{- $gitEmail = promptStringOnce . "git.email" "Personal git user.email" -}}
{{- $gitUsername = promptStringOnce . "git.username" "Git username" -}}
{{- $workProfile = promptBoolOnce . "work_profile" "Is this your work machine? y/N" -}}
{{- $tdEmail = promptStringOnce . "git.identity_local.testdouble.email" "TestDouble git user.email (blank if unused on this machine)" "" -}}
{{- if $tdEmail -}}
{{- $tdKey = promptStringOnce . "git.identity_local.testdouble.signing_key" "TestDouble signing key, `ssh-add -L` output (blank = personal key)" "" -}}
{{- end -}}
{{- $ghEmail = promptStringOnce . "git.identity_local.gifthealth.email" "Gift Health git user.email (blank if unused on this machine)" "" -}}
{{- if $ghEmail -}}
{{- $ghKey = promptStringOnce . "git.identity_local.gifthealth.signing_key" "Gift Health signing key, `ssh-add -L` output (blank = personal key)" "" -}}
{{- end -}}
{{- /* trimAll guards against pasting a ref with its surrounding quotes still
       attached (e.g. copied from a JSON export) -- op read/onepasswordRead
       treat embedded quote characters as part of the reference and fail
       with "invalid secret reference" instead of a clear prompt-time error. */ -}}
{{- $credClaudeApi = promptStringOnce . "credentials.claude_api" "1Password ref for Claude API" | trimAll "\"" -}}
{{- $credBuildkite = promptStringOnce . "credentials.buildkite" "1Password ref for Buildkite" | trimAll "\"" -}}
{{- $useBedrock = promptBoolOnce . "claude.use_bedrock" "Use AWS Bedrock for Claude Code? y/N" -}}
{{- else -}}
{{- /* No TTY (CI, piped install, cron): skip prompts and read overrides from the environment. */ -}}
{{- $gitName = env "GIT_USER_NAME" -}}
{{- $gitEmail = env "GIT_USER_EMAIL" -}}
{{- $gitUsername = env "GIT_USERNAME" -}}
{{- $workProfile = eq (env "WORK_PROFILE") "true" -}}
{{- $tdEmail = env "GIT_TESTDOUBLE_EMAIL" -}}
{{- $tdKey = env "GIT_TESTDOUBLE_SIGNING_KEY" -}}
{{- $ghEmail = env "GIT_GIFTHEALTH_EMAIL" -}}
{{- $ghKey = env "GIT_GIFTHEALTH_SIGNING_KEY" -}}
{{- end }}
# Custom source directory so the dotfiles repo doesn't need to live under
# the default `~/.local/share/chezmoi/`.
sourceDir = "{{ .chezmoi.workingTree }}"

[onepassword]
mode = "account"
cache = true

[hooks.read-source-state.pre]
command = "{{ .chezmoi.workingTree }}/bin/install-password-manager"

[data]
work_profile = {{ $workProfile }}

[data.git]
name = {{ $gitName | quote }}
email = {{ $gitEmail | quote }}
username = {{ $gitUsername | quote }}

# Machine-local half of the identities declared in .chezmoidata/git.yaml.
# These live here rather than in the source tree because meaganewaller/dotfiles
# is public, and client email addresses and engagement-scoped signing keys do
# not belong in its history. Blank signing_key falls back to git.signing_key.
[data.git.identity_local.testdouble]
email = {{ $tdEmail | quote }}
signing_key = {{ $tdKey | quote }}

[data.git.identity_local.gifthealth]
email = {{ $ghEmail | quote }}
signing_key = {{ $ghKey | quote }}

[data.credentials]
claude_api = {{ $credClaudeApi | quote }}
buildkite = {{ $credBuildkite | quote }}

# Claude Code: when true, bin/sync-claude-settings resolves AWS Bedrock model IDs
# (via bin/resolve-bedrock-models) and merges them into settings.json; when false,
# those env vars are stripped and the Anthropic-direct default model is used.
[data.claude]
use_bedrock = {{ $useBedrock }}
