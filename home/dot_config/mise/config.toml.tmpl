{{- /*
# -*-mode:toml-*- vim:ft=toml.gotexttmpl
*/ -}}

[env]
# supports arbitrary env vars so mise can be used like direnv/dotenv
#
# Don't set NODE_ENV here. A global value leaks into every production build on
# the machine: `next build` inherited NODE_ENV=development and React resolved a
# mix of its dev and prod builds, leaving ReactSharedInternals null and failing
# the prerender with "null is not an object (evaluating 'k.H.useContext')".
# Tools set NODE_ENV themselves; per-project mise.toml can override when needed.
#
# Deliberately no `_.fnox-env` here, and no fnox plugin below. mise resolves
# this section on every activation and on every shim invocation, and that plugin
# answers by shelling out to `op read` -- which attaches a 1Password unlock to
# opening a terminal. It cost two unlocks per interactive fish (Homebrew's
# vendor_conf.d/mise-activate.fish activates mise before ~/.config/fish/conf.d,
# and config.fish activates it again, and each activation re-resolves) plus one
# per mise shim call, to inject a key that exactly one command wants.
#
# A secret reaches its consumer on demand instead, through `fnox exec`, which
# injects it into one process and leaves nothing behind. There is no file
# export: ~/.secrets was retired once it turned out to have one writer and no
# readers. See the note where the `secrets` task used to be, below, and
# dot_config/fnox/config.toml.

[settings]
verbose = false
jobs = 4
raw = false
yes = false
paranoid = false
gpg_verify = true
always_keep_download = false
always_keep_install = false
minimum_release_age = "3d"
trusted_config_paths = ["~/src/github.com/meaganewaller"]
experimental = true
lockfile = true
pin = true
env_file = ".env" # load env varsr from a dotenv file, see `MISE_ENV_FILE`
disable_backends = ["asdf", "vfox", "dotnet"]
disable_tools = ["java"]

[settings.python]
uv_venv_auto = true

[settings.pipx]
uvx = true

[settings.ruby]
compile = false

