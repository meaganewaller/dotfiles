git:
  pagers:
    - colorArg: always
      pager: delta --dark --paging=never --line-numbers --true-color=always --hunk-header-style=omit

# The `G` AI Commit custom command was removed along with aichat: its backing
# script called `aichat -r commit`, and that role requested a model no client
# was configured for, so the menu had been failing rather than generating.
# Commits route through the `/git-workflow:commit` skill instead.
