amends "package://github.com/jdx/hk/releases/download/v2.2.0/hk@2.2.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    steps {
      ["gitleaks"] {
        check = "gitleaks git --pre-commit --redact --staged --verbose --no-banner"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["gitleaks"] {
        check = "gitleaks git --no-banner --redact --verbose --log-opts=\"HEAD --not --remotes\""
      }
    }
  }
  ["check"] {
    steps {
      ["gitleaks"] {
        check = "gitleaks git --no-banner --verbose"
      }
    }
  }
}
