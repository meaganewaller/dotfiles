amends "package://github.com/jdx/hk/releases/download/v2.3.1/hk@2.3.1#/Config.pkl"

hooks {
  ["pre-commit"] {
    steps {
      ["betterleaks"] {
        check = "betterleaks git --pre-commit --redact --staged --verbose --no-banner"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["betterleaks"] {
        check = "betterleaks git --no-banner --redact --verbose --log-opts=\"HEAD --not --remotes\""
      }
    }
  }
  ["check"] {
    steps {
      ["betterleaks"] {
        check = "betterleaks git --no-banner --verbose"
      }
    }
  }
}
