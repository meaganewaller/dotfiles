amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    steps {
      ["betterleaks"] {
        check = "betterleaks git --pre-commit --redact --staged --verbose --no-banner"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["betterleaks"] {
        // The script reads what the push actually sends from git's pre-push
        // input. hook_args goes through stdin too: rendered into the command,
        // it would be an unquoted remote URL.
        stdin = "{{ hook_args }}\n{{ hook_stdin }}"
        check = "\"$HOME/.config/hk/pre-push-scan\""
      }
    }
  }
  ["check"] {
    steps {
      ["betterleaks"] {
        check = "betterleaks git --no-banner --redact --verbose"
      }
    }
  }
}
