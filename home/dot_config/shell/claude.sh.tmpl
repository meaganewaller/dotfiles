{{- /*
     Account dispatch for Claude Code, shared by zsh and bash.

     Rendered from claudeData in home/.chezmoidata/claude.yaml: every key other
     than `shared` is an account, so adding a third account there gets a wrapper
     here for free. Fish has its own copy of this logic in
     home/dot_config/fish/conf.d/10-claude.fish.tmpl, rendered from the same
     data -- fish cannot source POSIX shell, so the two files are deliberate
     twins rather than one shared file.
*/ -}}
{{- $accounts := list -}}
{{- range $name, $_ := .claudeData -}}
{{-   if ne $name "shared" -}}
{{-     $accounts = append $accounts $name -}}
{{-   end -}}
{{- end -}}
{{- $accounts = sortAlpha $accounts -}}
{{- $commands := list -}}
{{- range $accounts -}}
{{-   $commands = append $commands (printf "claude-%s" .) -}}
{{- end -}}
# Claude Code account dispatch. Sourced by ~/.zshrc and ~/.bashrc.
#
# GENERATED by chezmoi from home/dot_config/shell/claude.sh.tmpl -- edit that,
# not this file. Fish gets the same behavior from
# ~/.config/fish/conf.d/10-claude.fish.
#
# There is deliberately no bare `claude` command. This setup is multi-account
# only (ADR 0010): there is no ~/.claude, and the CLI creates one when
# CLAUDE_CONFIG_DIR is unset, so a bare `claude` silently starts a session with
# neither account's settings, plugins, or MCP servers. `claude` is redefined
# below to say that rather than left to run.

# Run Claude Code against one account's config directory.
#
# $1 is the config dir; the rest is passed through. Two behaviors are folded in:
#
#   --add-dir ~/src is injected only for session launches. It is variadic, so on
#   a management subcommand (`claude mcp add ...`) it would swallow `mcp add` as
#   more directories and the subcommand would never run.
#
#   claude-chill, when installed, wraps the real binary. It is resolved at call
#   time rather than at chezmoi render time so installing it later takes effect
#   without a re-apply.
#
# `command claude` throughout, because `claude` is a function here.
_claude_account() {
	local _claude_dir="$1"
	shift

	case "${1-}" in
	agents | auth | auto-mode | doctor | install | mcp | plugin | plugins | project | setup-token | ultrareview | update | upgrade) ;;
	*)
		set -- --add-dir "$HOME/src" "$@"
		;;
	esac

	if command -v claude-chill >/dev/null 2>&1; then
		CLAUDE_CONFIG_DIR="$_claude_dir" claude-chill -- command claude "$@"
	else
		CLAUDE_CONFIG_DIR="$_claude_dir" command claude "$@"
	fi
}
{{ range $accounts }}
claude-{{ . }}() { _claude_account "$HOME/.claude-{{ . }}" "$@"; }
{{- end }}

# Non-zero, not just a message: a bare `claude` in a script or a stale alias
# should fail the pipeline rather than look like it succeeded.
claude() {
	printf 'claude: pick an account -- %s\n' '{{ join ", " $commands }}' >&2
	return 1
}
