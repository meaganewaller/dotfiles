{{- /*
     Credential wrapper for `bd linear`, shared by zsh and bash.

     Fish has its own copy in home/dot_config/fish/conf.d/21-bd.fish.tmpl --
     fish cannot source POSIX shell, so the two files are deliberate twins
     rather than one shared file. Change both.
*/ -}}
{{- if and (lookPath "fnox") (lookPath "bd") -}}
# LINEAR_API_KEY for `bd linear`, per invocation. Sourced by ~/.zshrc and
# ~/.bashrc.
#
# GENERATED by chezmoi from home/dot_config/shell/bd.sh.tmpl -- edit that, not
# this file. Fish gets the same behavior from ~/.config/fish/conf.d/21-bd.fish.
#
# Why a function and not an exported variable: #345 removed mise's `_.fnox-env`
# because mise re-resolves its environment on every activation and every shim
# call, and the fnox plugin answered each one with `op read` -- two Touch ID
# unlocks per terminal, plus one per shim invocation. Defining a function costs
# nothing; fnox runs only when a `bd linear` command is actually typed, so shell
# startup still makes zero `op` calls. test/shell-startup-secrets.bats guards
# that, and test/bd-linear-credential-wrapper.bats guards this.
#
# Why it dispatches instead of wrapping the whole binary: `bd` is on the hot
# path. Session hooks, `bd ready`, `bd prime`, `bd show` and `bd close` run
# several times per agent turn, and an alias over the binary would put an
# `op read` in front of every one of them -- relocating the cost #345 removed
# rather than removing it. Only `bd linear` talks to the Linear API.
#
# `--config` is load-bearing: fnox merges every fnox.toml from the cwd upward,
# so without it, running from inside a project with its own manifest would let
# that project shadow the machine-wide one.
#
# The fnox branch ends in `bd`, not `command bd`: `command` is a shell builtin
# and `fnox exec` does a PATH lookup, so it would fail to exec. fnox spawns a
# fresh process where shell functions do not exist, so plain `bd` resolves to
# the real binary with no recursion. The else branch runs in this shell, so it
# does need `command`.
bd() {
	if [ "$1" = linear ]; then
		fnox exec --config "$HOME/.config/fnox/config.toml" -- bd "$@"
	else
		command bd "$@"
	fi
}
{{- end }}
