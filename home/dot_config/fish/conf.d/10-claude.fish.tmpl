{{- /*
     Fish twin of home/dot_config/shell/claude.sh.tmpl, rendered from the same
     claudeData in home/.chezmoidata/claude.yaml. Fish cannot source POSIX
     shell, so the logic is duplicated rather than shared -- change both.
*/ -}}
{{- $accounts := list -}}
{{- range $name, $_ := .claudeData -}}
{{-   if ne $name "shared" -}}
{{-     $accounts = append $accounts $name -}}
{{-   end -}}
{{- end -}}
{{- $accounts = sortAlpha $accounts -}}
{{- $commands := list -}}
{{- range $accounts -}}
{{-   $commands = append $commands (printf "claude-%s" .) -}}
{{- end -}}
# Claude Code account dispatch.
#
# GENERATED by chezmoi from home/dot_config/fish/conf.d/10-claude.fish.tmpl --
# edit that, not this file. zsh and bash get the same behavior from
# ~/.config/shell/claude.sh.
#
# There is deliberately no bare `claude` command. This setup is multi-account
# only (ADR 0010): there is no ~/.claude, and the CLI creates one when
# CLAUDE_CONFIG_DIR is unset, so a bare `claude` silently starts a session with
# neither account's settings, plugins, or MCP servers.

# Run Claude Code against one account's config directory.
#
# $argv[1] is the config dir; the rest is passed through. Two behaviors are
# folded in:
#
#   --add-dir ~/src is injected only for session launches. It is variadic, so on
#   a management subcommand (`claude mcp add ...`) it would swallow `mcp add` as
#   more directories and the subcommand would never run.
#
#   claude-chill, when installed, wraps the real binary. It is resolved at call
#   time rather than at chezmoi render time so installing it later takes effect
#   without a re-apply.
#
# `command claude` throughout, because `claude` is a function here. It also
# replaces the hardcoded /opt/homebrew/bin/claude this file used to carry, so an
# Intel Mac, a Linux box, or a mise-managed install resolves correctly.
function _claude_account
    set -l claude_dir $argv[1]
    set -l args $argv[2..-1]

    switch "$args[1]"
        case agents auth auto-mode doctor install mcp plugin plugins project setup-token ultrareview update upgrade
            # management subcommand: pass through untouched
        case '*'
            set args --add-dir "$HOME/src" $args
    end

    if command -q claude-chill
        CLAUDE_CONFIG_DIR=$claude_dir claude-chill -- command claude $args
    else
        CLAUDE_CONFIG_DIR=$claude_dir command claude $args
    end
end
{{ range $accounts }}
function claude-{{ . }}
    _claude_account "$HOME/.claude-{{ . }}" $argv
end
{{ end }}
# Non-zero, not just a message: a bare `claude` in a script should fail rather
# than look like it succeeded.
function claude
    echo 'claude: pick an account -- {{ join ", " $commands }}' >&2
    return 1
end
