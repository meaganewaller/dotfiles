{{- /*
# -*-mode:fish-*- vim:ft=fish.gotexttmpl
*/ -}}
# Credential-injecting aliases, twinned with the zsh block in dot_zshrc.tmpl.
#
# fnox resolves each secret from 1Password per invocation and injects it into
# that process only. The profiles named here are not the ones mise selects, so
# these credentials never reach the shell environment or ~/.secrets.
#
# Source of truth for the tool/profile pairs is `aliases.credentials` in
# .chezmoidata/aliases.yaml; the op:// refs are in dot_config/fnox/config.toml.
{{- with index .aliases "credentials" }}
{{- range . }}
{{- if and (lookPath "fnox") (lookPath .tool) }}
alias {{ if hasKey . "alias" }}{{ .alias }}{{ else }}{{ .tool }}{{ end }} 'fnox exec --config "$HOME/.config/fnox/config.toml" --profile {{ .profile }} -- {{ .tool }}'
{{- end }}
{{- end }}
{{- end }}
