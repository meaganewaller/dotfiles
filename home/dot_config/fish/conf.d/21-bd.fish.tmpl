{{- /*
     Fish twin of home/dot_config/shell/bd.sh.tmpl. Fish cannot source POSIX
     shell, so the logic is duplicated rather than shared -- change both.
*/ -}}
{{- if and (lookPath "fnox") (lookPath "bd") -}}
# LINEAR_API_KEY for `bd linear`, per invocation.
#
# GENERATED by chezmoi from home/dot_config/fish/conf.d/21-bd.fish.tmpl -- edit
# that, not this file. zsh and bash get the same behavior from
# ~/.config/shell/bd.sh, which carries the full rationale.
#
# In short: defining the function costs nothing, so shell startup still makes
# zero `op` calls (#345), and dispatching on the first argument keeps the hot
# path -- `bd ready`, `bd prime`, `bd show`, `bd close`, and every session hook
# -- from paying for a credential only `bd linear` needs.
#
# `--if-missing error` is not optional: fnox defaults to `warn`, so a locked
# 1Password would otherwise let `bd linear sync` run unauthenticated at exit 0.
#
# No `--wraps`. The usual wrapper idiom names the underlying command, but this
# function and that command share the name `bd`, so it would be a completion
# loop rather than a no-op. Fish resolves `complete -c bd` by name whether bd is
# a function or a binary, so the flag buys nothing here.
#
# A quoted out-of-range index expands to the empty string in fish, so a bare
# `bd` takes the else branch and prints its own usage, as before.
function bd
    if test "$argv[1]" = linear
        fnox exec --config "$HOME/.config/fnox/config.toml" --if-missing error -- bd $argv
    else
        command bd $argv
    end
end
{{- end }}
