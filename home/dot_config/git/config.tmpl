[user]
	name = {{ .git.name }}
	email = {{ .git.email }}
	signingkey = {{ .git.signing_key }}
	useConfigOnly = true

[init]
	defaultBranch = main

# SSH commit signing, backed by 1Password. The private key never leaves the
# vault: op-ssh-sign asks the 1Password agent to sign, and the agent's vault is
# configured in dot_config/1Password/ssh/agent.toml.
#
# The pubkey at signingkey must also be registered on GitHub as an SSH signing
# key (Settings → SSH and GPG keys → New SSH key → Key type: "Signing Key") so
# server-side verification passes — auth keys alone are not enough.
#
# allowedSignersFile is what makes *local* verification work: without it,
# `git log --show-signature` errors out and %G? reports N for every commit, even
# though the commits are correctly signed.
[gpg]
	format = ssh

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = {{ .git.allowed_signers_file }}

# Push over SSH (1Password holds the key) but leave *fetches* on HTTPS.
#
# This was a bare `insteadOf`, which rewrote fetch URLs too. That broke every
# unauthenticated clone -- CI has no SSH key, so chezmoi's git-repo externals
# died with "Permission denied (publickey)" on an https:// URL. It also made
# the `gh auth git-credential` helper below unreachable, since no github.com
# URL ever stayed on HTTPS long enough to consult it.
[url "ssh://git@github.com/"]
	pushInsteadOf = https://github.com/

[commit]
	gpgsign = true
	verbose = true

[tag]
	gpgsign = true

[core]
	editor = nvim
	excludesfile = ~/.config/git/ignore
	autocrlf = input
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[rebase]
	autoStash = true

[status]
	showStash = true
	showUntrackedFiles = all

[checkout]
	workers = 0

[log]
	date = relative

[alias]
	# Basic shortcuts
	co = checkout
	br = branch
	ci = commit
	st = status

	# Better logging — pipes through `emojify` so commit shortcodes (`:bug:`, `:sparkles:`) render as glyphs.
	# `emojify`'s shebang resolves bash via PATH and macOS picks /bin/bash 3.2.57, which modern emojify rejects —
	# so invoke it under brew's bash explicitly, falling back to PATH bash on systems without brew.
	lg = "!f() { b=\"$(brew --prefix bash 2>/dev/null)/bin/bash\"; [ -x \"$b\" ] || b=bash; git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit \"$@\" | \"$b\" \"$(command -v emojify)\" | less -FRX; }; f"
	lga = "!f() { b=\"$(brew --prefix bash 2>/dev/null)/bin/bash\"; [ -x \"$b\" ] || b=bash; git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all \"$@\" | \"$b\" \"$(command -v emojify)\" | less -FRX; }; f"

	# Show files in a commit
	show-files = show --pretty="" --name-only

	# Undo last commit
	undo = reset HEAD~1 --mixed

	# Clean up merged branches
	cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

	# Quick commit and push
	cap = "!git add . && git commit -m"

	# Interactive rebase
	ri = rebase -i

	# Show current branch
	current = branch --show-current

[color]
	ui = auto
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red
	new = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[help]
	autocorrect = 1

[rerere]
	enabled = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[include]
	path = ~/.config/git/config.local
{{ if lookPath "gh" -}}
[credential "https://github.com"]
	helper =
	helper = !{{ lookPath "gh" }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ lookPath "gh" }} auth git-credential
{{ end -}}

{{- /* Per-identity overlays. Every identity in .chezmoidata/git.yaml's
       `git.identities` whose email is filled in on this machine gets one
       includeIf per org directory, pointing at its own overlay file. An
       identity with a blank email renders nothing here, and its overlay file
       renders empty and is skipped -- so the two can never disagree. */ -}}
{{- $localAll := dict -}}
{{- if hasKey .git "identity_local" }}{{ $localAll = .git.identity_local }}{{ end -}}

# Two non-obvious requirements below, both verified against git 2.50 -- get
# either wrong and these blocks silently do nothing at all:
#
#   1. The pattern MUST end in "/". Git appends "**" only to a pattern that
#      ends in a slash, so "gitdir:~/src/github.com/gifthealth" matches a
#      gitdir at exactly that path -- i.e. never a repo *inside* it. The slash
#      is appended by the template rather than stored per-entry in git.yaml so
#      that it cannot be forgotten for one client. The single pattern that used
#      to live here had no slash, so this overlay had never applied to a single
#      repo, for any client, since the day it was written.
#   2. "gitdir/i:" (case-insensitive). The checkout on disk is
#      ~/src/github.com/Gifthealth, the GitHub org is giftHEALTH, and the
#      pattern here is lowercase -- three different spellings of one name.
#      Plain "gitdir:" compares case-sensitively even on a case-insensitive
#      APFS volume, so it would miss.
{{ range .git.identities -}}
{{- $key := .key -}}
{{- $local := merge (dict) (index $localAll $key | default dict) (dict "email" "" "signing_key" "") -}}
{{- if $local.email -}}
{{- range .dirs }}
[includeIf "gitdir/i:{{ . }}/"]
	path = ~/.config/git/identity_{{ $key }}.gitconfig
{{- end }}
{{ end -}}
{{- end -}}
