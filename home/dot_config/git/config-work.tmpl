{{- /*
Included via [includeIf "gitdir:~/workspace/"] in config.tmpl, only on
machines where work_profile is true (see .chezmoiignore). Overrides just the
identity/key fields that differ from the personal defaults in config.tmpl.
*/ -}}
[user]
	email = {{ .git.work_email }}
	signingkey = ~/.ssh/id_ed25519.pub

[core]
	sshCommand = "ssh -o IdentitiesOnly=yes -o IdentityFile=~/.ssh/id_ed25519.pub"
