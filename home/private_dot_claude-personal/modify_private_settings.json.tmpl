#!/bin/bash
# Merges desired settings into the current settings.json
# Keys managed by Claude Code (e.g. "model") are preserved rather than overwritten.

set -euo pipefail

desired=$(cat <<'DESIRED'
{
  "tui": "fullscreen",
  "copyOnSelect": false,
  "prStatusFooterEnabled": false,
  "showClearContextOnPlanAccept": true,
  "awaySummaryEnabled": false,
  "autoUpdaterChannel": "stable",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-code-statusline",
    "padding": 0
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "MAX_THINKING_TOKENS": "128000"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude-personal/hooks/tmux-bell.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      { 
        "matcher": "Write|Edit|MultiEdit", 
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude-personal/hooks/check-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/libexec/block-adhoc-installers"
          }
        ]
      }
    ]
  }
}
DESIRED
)

current=$(cat)

if ! command -v jq &>/dev/null; then
  printf '%s\n' "${current:-$desired}"
  exit 0
fi

if [[ -z "$current" ]]; then
  printf '%s\n' "$desired" | jq --indent 2 '.'
else
  printf '%s' "$current" | jq --indent 2 --argjson desired "$desired" '. * $desired'
fi
