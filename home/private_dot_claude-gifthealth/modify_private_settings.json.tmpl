#!/bin/bash
# Merge the declared settings for this account into the current settings.json.
#
# Everything below the heredoc is generated from home/.chezmoidata/claude.yaml +
# claude-permissions.yaml by home/.chezmoitemplates/claude-settings. To change a
# permission, feature flag, env var, or hook, edit the data — not this file.
#
# The merge is `current * desired`, so keys Claude Code owns and we do not
# declare (theme, extraKnownMarketplaces, enabledPlugins, ...) survive untouched.
# jq's `*` recurses into objects but replaces arrays wholesale, which is what we
# want: dropping a permission or a hook from the data removes it from the file.

set -euo pipefail

desired=$(cat <<'DESIRED'
{{ template "claude-settings" dict "account" "gifthealth" "data" . }}
DESIRED
)

current=$(cat)

if ! command -v jq &>/dev/null; then
  printf '%s\n' "${current:-$desired}"
  exit 0
fi

if [[ -z "$current" ]]; then
  merged=$(printf '%s\n' "$desired" | jq --indent 2 '.') || merged=""
else
  merged=$(printf '%s' "$current" | jq --indent 2 --argjson desired "$desired" '. * $desired') || merged=""
fi

# Never hand chezmoi a file that would not parse: fall back to leaving the
# existing settings.json alone.
if [[ -n "$merged" ]] && printf '%s' "$merged" | jq empty &>/dev/null; then
  printf '%s\n' "$merged"
else
  printf '%s\n' "${current:-$desired}"
fi
