#!/bin/sh
#
# setup -- Development Tools Setup Script
#

[ -n "${DEBUG:-}" ] && set -o xtrace
set -o errexit
set -o nounset

# Check if mise is available
if ! command -v mise >/dev/null 2>&1; then
  cat >&2 <<'EOF'
Warning: mise was not found in PATH.

This project uses mise to manage its developer tools.

Using mise is optional. You can run `bin/test` and `chezmoi` yourself,
but you will need to install required dependencies on your own.

- For hints, read `.mise.toml`.
- For a fully self-contained environment, use Dev Containers (VS Code / Cursor).

Docs: https://mise.jdx.dev
EOF
  exit 1
fi

# Install only the tools declared in THIS repo's mise.toml, not `mise
# install`'s default of every tool in the merged local+global config. An
# unrelated broken tool in the global user config (e.g. one unsupported on
# the current arch, or a bad upstream version) would otherwise fail this
# script even though everything bin/test/hk actually need installed fine.
# See dotfiles-f14.
tools=$(mise ls --local | awk '{print $1}')
if [ -z "$tools" ]; then
  echo "bin/setup: mise ls --local returned no tools; refusing to fall back to an unscoped 'mise install'" >&2
  exit 1
fi

# shellcheck disable=SC2086 # word-splitting is intentional: one tool per line/arg
exec mise install $tools
