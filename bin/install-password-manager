#!/bin/sh
#
# Install the 1Password CLI (`op`) for the templates' onepasswordRead calls.
# Runs as chezmoi's read-source-state.pre hook (home/.chezmoi.toml.tmpl), so it
# runs before every chezmoi command until op exists, and a failure here stops
# chezmoi entirely.
#
# On Linux it installs from 1Password's apt or dnf repository, trusting only
# the signing key committed at share/1password/1password.asc. The package
# manager checks every download against that key. There is also no "latest
# version" lookup to race a release: the old zip download 404'd when 1Password's
# update check announced a version before its CDN had the file (dotfiles-3ub).
#
# SYSROOT prefixes every system path written, so the tests can run this
# without root.

set -eu

# exit immediately if password-manager-binary is already in $PATH
type op >/dev/null 2>&1 && exit 0

KEY="$(cd "$(dirname "$0")/.." && pwd)/share/1password/1password.asc"
REPO="https://downloads.1password.com/linux"
SYSROOT="${SYSROOT:-}"

install_apt() {
	arch=$(dpkg --print-architecture)
	case "$arch" in
	amd64 | arm64) ;;
	*)
		echo "install-password-manager: 1Password has no apt repository for $arch" >&2
		exit 1
		;;
	esac

	sudo mkdir -p "$SYSROOT/etc/apt/keyrings" "$SYSROOT/etc/apt/sources.list.d"
	sudo install -m 0644 "$KEY" "$SYSROOT/etc/apt/keyrings/1password.asc"
	printf '%s\n' \
		'Types: deb' \
		"URIs: $REPO/debian/$arch" \
		'Suites: stable' \
		'Components: main' \
		'Signed-By: /etc/apt/keyrings/1password.asc' |
		sudo tee "$SYSROOT/etc/apt/sources.list.d/1password.sources" >/dev/null

	sudo apt-get update
	sudo apt-get install -y 1password-cli
}

install_dnf() {
	sudo mkdir -p "$SYSROOT/etc/pki/rpm-gpg" "$SYSROOT/etc/yum.repos.d"
	sudo install -m 0644 "$KEY" "$SYSROOT/etc/pki/rpm-gpg/1password.asc"
	# repo_gpgcheck covers the metadata as well as each package.
	printf '%s\n' \
		'[1password]' \
		'name=1Password Stable Channel' \
		"baseurl=$REPO/rpm/stable/\$basearch" \
		'enabled=1' \
		'gpgcheck=1' \
		'repo_gpgcheck=1' \
		'gpgkey=file:///etc/pki/rpm-gpg/1password.asc' |
		sudo tee "$SYSROOT/etc/yum.repos.d/1password.repo" >/dev/null

	sudo dnf install -y 1password-cli
}

case "$(uname -s)" in
Darwin)
	brew install 1password-cli
	;;
Linux)
	if command -v apt-get >/dev/null 2>&1; then
		install_apt
	elif command -v dnf >/dev/null 2>&1; then
		install_dnf
	else
		echo "install-password-manager: no apt-get or dnf; install the 1Password CLI by hand:" >&2
		echo "  https://developer.1password.com/docs/cli/get-started/" >&2
		exit 1
	fi
	;;
*)
	echo "unsupported OS"
	exit 1
	;;
esac
