{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    ':disableDependencyDashboard',
  ],
  timezone: 'America/New_York',
  platformCommit: 'enabled',
  configMigration: true,
  automerge: true,
  automergeStrategy: 'squash',
  prHourlyLimit: 2,
  labels: [
    'type:chore',
  ],
  enabledManagers: [
    'mise',
    'github-actions',
    'dockerfile',
    'custom.regex',
    'custom.jsonata',
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'at any time',
    ],
  },
  mise: {
    managerFilePatterns: [
      '/^mise\\.toml$/',
    ],
  },
  'github-actions': {
    pinDigests: true,
    managerFilePatterns: [
      '/^\\.github/workflows/.*\\.ya?ml$/',
    ],
  },
  dockerfile: {
    pinDigests: true,
    managerFilePatterns: [
      '/^Dockerfile$/',
    ],
  },
  packageRules: [
    {
      matchManagers: [
        'mise',
      ],
      extractVersion: '^v?(?<version>.+)$',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/dotfiles/cli-versions\\.toml$/',
      ],
      matchStrings: [
        '^cosign\\s*=\\s*"(?<currentValue>v?[^"]+)"',
      ],
      depNameTemplate: 'sigstore/cosign',
      datasourceTemplate: 'github-releases',
    },
    // The five managers below cover the user mise config. Two constraints shape
    // them, and both are easy to "fix" into breakage:
    //
    // 1. Regex, not the native `mise` manager: that file is a Chezmoi template
    //    whose Go directives make it invalid TOML, and Renovate's mise manager
    //    returns nothing when TOML parsing fails. Its sibling mise.lock cannot
    //    stand in either -- Renovate only reads a mise.lock as a companion to a
    //    config it already parsed.
    // 2. currentValue must start with a digit, so `latest` never matches. Per
    //    docs/adrs/0003-mise-config-plus-lockfile.md, `latest` in that config is
    //    deliberate policy (intent lives in config, resolved versions live in the
    //    committed mise.lock). Widening these to match `latest` would open a PR
    //    per tool rewriting that policy away.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/mise/config\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        '"aqua:(?<depName>[^/"]+/[^/"]+)"\\s*=\\s*"(?<currentValue>v?\\d[^"]*)"',
      ],
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v?(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/mise/config\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        '"github:(?<depName>[^/"]+/[^/"]+)"\\s*=\\s*"(?<currentValue>v?\\d[^"]*)"',
      ],
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v?(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/mise/config\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        '"ubi:(?<depName>[^/"]+/[^/"]+)"\\s*=\\s*"(?<currentValue>v?\\d[^"]*)"',
      ],
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v?(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/mise/config\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        '"npm:(?<depName>[^"]+)"\\s*=\\s*"(?<currentValue>\\d[^"]*)"',
      ],
      datasourceTemplate: 'npm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/mise/config\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        '"pipx:(?<depName>[^"]+)"\\s*=\\s*"(?<currentValue>\\d[^"]*)"',
      ],
      datasourceTemplate: 'pypi',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hk\\.pkl$/',
      ],
      matchStrings: [
        'github\\.com/jdx/hk/releases/download/(?<currentValue>v[^/]+)/hk@[^#"]+',
      ],
      depNameTemplate: 'jdx/hk',
      datasourceTemplate: 'github-releases',
    },
    {
      // LOCKSTEP: the icon_map.lua release tag below and the
      // `font-sketchybar-app-font` cask in home/.chezmoidata/packages.yaml are
      // the SAME upstream project and must move together. Casks live in
      // packages.yaml, which Renovate does not manage (brew is not in
      // enabledManagers), so they cannot be grouped into one PR here. When this
      // PR bumps the tag, manually re-run `brew info --cask font-sketchybar-app-font`
      // and confirm the cask matches; do not let the two drift.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoiexternals/sketchybar-app-font\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        'kvndrsslr/sketchybar-app-font/releases/download/(?<currentValue>v[^/]+)/icon_map\\.lua',
      ],
      depNameTemplate: 'kvndrsslr/sketchybar-app-font',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/go-tools/tools\\.txt$/',
      ],
      matchStrings: [
        '^(?<depName>[^\\s@]+)@(?<currentValue>v?[^\\s#]+)',
      ],
      datasourceTemplate: 'go',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/node-tools/tools\\.txt$/',
      ],
      matchStrings: [
        '^(?<depName>[^@\\n]+)@(?<currentValue>[^\\n#]+)',
      ],
      datasourceTemplate: 'npm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoiexternals/ghostty\\.toml$/',
      ],
      matchStrings: [
        'catppuccin/ghostty/archive/(?<currentDigest>[a-f0-9]{7,40})\\.tar\\.gz',
      ],
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'main',
      depNameTemplate: 'catppuccin/ghostty',
      packageNameTemplate: 'https://github.com/catppuccin/ghostty',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoiexternals/zsh\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        'ohmyzsh/ohmyzsh/archive/(?<currentDigest>[a-f0-9]{7,40})\\.tar\\.gz',
      ],
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'master',
      depNameTemplate: 'ohmyzsh/ohmyzsh',
      packageNameTemplate: 'https://github.com/ohmyzsh/ohmyzsh',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoiexternals/zsh\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        'zsh-users/zsh-autosuggestions/archive/(?<currentDigest>[a-f0-9]{7,40})\\.tar\\.gz',
      ],
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'master',
      depNameTemplate: 'zsh-users/zsh-autosuggestions',
      packageNameTemplate: 'https://github.com/zsh-users/zsh-autosuggestions',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoiexternals/zsh\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        'zsh-users/zsh-syntax-highlighting/archive/(?<currentDigest>[a-f0-9]{7,40})\\.tar\\.gz',
      ],
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'master',
      depNameTemplate: 'zsh-users/zsh-syntax-highlighting',
      packageNameTemplate: 'https://github.com/zsh-users/zsh-syntax-highlighting',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoiexternals/fish\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        'twpayne/chezmoi/(?<currentDigest>[a-f0-9]{7,40})/completions/chezmoi\\.fish',
      ],
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'master',
      depNameTemplate: 'twpayne/chezmoi',
      packageNameTemplate: 'https://github.com/twpayne/chezmoi',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoiexternals/fish\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        'watchexec/watchexec/(?<currentDigest>[a-f0-9]{7,40})/completions/fish',
      ],
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'main',
      depNameTemplate: 'watchexec/watchexec',
      packageNameTemplate: 'https://github.com/watchexec/watchexec',
    },
    {
      // Matches all 4 tokyonight_*.theme occurrences in this file -- same repo/SHA,
      // grouped by Renovate into one PR since they share depName/packageName.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoiexternals/fish\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        'folke/tokyonight\\.nvim/(?<currentDigest>[a-f0-9]{7,40})/extras/fish_themes/',
      ],
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'main',
      depNameTemplate: 'folke/tokyonight.nvim',
      packageNameTemplate: 'https://github.com/folke/tokyonight.nvim',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoiexternals/sketchybar-lua\\.toml\\.tmpl$/',
      ],
      matchStrings: [
        'revision\\s*=\\s*"(?<currentDigest>[a-f0-9]{7,40})"',
      ],
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'main',
      depNameTemplate: 'FelixKratz/SbarLua',
      packageNameTemplate: 'https://github.com/FelixKratz/SbarLua',
    },
    {
      customType: 'jsonata',
      fileFormat: 'yaml',
      managerFilePatterns: [
        '/^home/\\.chezmoidata/tmux-plugins\\.yaml$/',
      ],
      // Catalog `url`s are full clone URLs with an inconsistent `.git` suffix, so
      // reduce them to owner/repo for depName. `branch` is per-entry because these
      // repos disagree on their default branch name.
      matchStrings: [
        'tmux_plugins.extras.{ "depName": $replace($replace(url, "https://github.com/", ""), ".git", ""), "currentValue": branch, "currentDigest": revision }',
      ],
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://github.com/{{{depName}}}',
    },
    {
      // nvim-pack-lock.json is generated/rewritten by Neovim's vim.pack manager, so we
      // can't add a per-entry branch field the way tmux-plugins.yaml does. currentValue
      // 'HEAD' doesn't work either: git-refs' getDigest only takes the type==='' HEAD
      // fallback when no newValue is passed, but Renovate always passes currentValue as
      // newValue here, and no ref has type 'heads'/'tags' with value 'HEAD' -- so it can
      // never resolve. Instead, hardcode each repo's real default branch (verified via
      // `gh api repos/<owner>/<repo> --jq .default_branch`) in a lookup table.
      customType: 'jsonata',
      fileFormat: 'json',
      managerFilePatterns: [
        '/^home/dot_config/nvim/nvim-pack-lock\\.json$/',
      ],
      matchStrings: [
        '$each(plugins, function($v, $k) { { "depName": $k, "packageName": $v.src, "currentDigest": $v.rev, "currentValue": $lookup({ "Saghen/blink.cmp": "main", "rockerBOO/boo-colorscheme-nvim": "main", "catppuccin/nvim": "main", "zootedb0t/citruszest.nvim": "main", "xero/evangelion.nvim": "main", "everviolet/nvim": "main", "ibhagwan/fzf-lua": "main", "lewis6991/gitsigns.nvim": "main", "ellisonleao/gruvbox.nvim": "main", "rebelot/kanagawa.nvim": "master", "nvim-lualine/lualine.nvim": "master", "savq/melange-nvim": "master", "xero/miasma.nvim": "main", "trapd00r/neverland-vim-theme": "master", "EdenEast/nightfox.nvim": "main", "nvim-treesitter/nvim-treesitter": "main", "nvim-tree/nvim-web-devicons": "master", "stevearc/oil.nvim": "master", "navarasu/onedark.nvim": "master", "rose-pine/neovim": "main", "b0o/schemastore.nvim": "main", "folke/tokyonight.nvim": "main", "vague-theme/vague.nvim": "main", "danilo-augusto/vim-afterglow": "master", "folke/which-key.nvim": "main", "bettervim/yugen.nvim": "main" }, $replace($v.src, "https://github.com/", "")) } })',
      ],
      datasourceTemplate: 'git-refs',
    },
  ],
}
