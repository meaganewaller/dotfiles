{
  "name": "dotfiles",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "GIT_USER_NAME": "${localEnv:GIT_USER_NAME:Dev Container User}",
      "GIT_USER_EMAIL": "${localEnv:GIT_USER_EMAIL:devcontainer@example.com}"
    }
  },
  "remoteUser": "dev",
  "workspaceFolder": "/home/dev/src/github.com/meaganewaller/dotfiles",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/dev/src/github.com/meaganewaller/dotfiles,type=bind,consistency=cached",
  "remoteEnv": {
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },
  "postCreateCommand": "bin/setup"
}
